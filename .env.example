# Copy this file to .env in the repository root.
# Keep the Groq key on the backend only; never use a VITE_ prefix for it.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=whisper-large-v3-turbo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local frontend requests use the Vite proxy by default.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
