{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vaani: API",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m", "uvicorn", "app.main:app",
        "--reload", "--host", "127.0.0.1", "--port", "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": {
          "CORS_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Vaani: Web",
      "type": "process",
      "command": "${workspaceFolder}\\tools\\node-v24.22.3-win-x64\\node.exe",
      "args": ["node_modules/vite/bin/vite.js", "--host", "127.0.0.1", "--port", "5173"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    }
  ]
}
